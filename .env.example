# Environment example

# Optional: Hugging Face (text generation) API key
HF_API_KEY=

# Optional: Coqui TTS server URL (e.g. http://localhost:5002)
COQUI_TTS_URL=

# Optional: Unsplash access key (or leave blank to use picsum placeholders)
UNSPLASH_ACCESS_KEY=

# Output directory
OUTPUT_DIR=out

# Fallback language (for prompts)
DEFAULT_LANGUAGE=tr

# Optional: YouTube / Instagram / TikTok upload keys (only used if you enable upload scripts)
YOUTUBE_OAUTH_REFRESH=
INSTAGRAM_PAGE_ACCESS_TOKEN=
TIKTOK_CLIENT_TOKEN=
